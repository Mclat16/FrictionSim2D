# LAMMPS: assemble matched per-material supercells into ONE periodic hetero cell.
# Generated by FrictionSim2D assemble_hetero_stack().
#
# The two (or more) per-material coincidence supercells already SHARE one
# in-plane periodic box (Task 3). This script reproduces that shared box, then
# reads every layer into it with:
#   * its z-shift (per-interface spacing from a real minimization),
#   * its global atom-type offset (from the PotentialManager, so assembled
#     types line up with the real potential exactly), and
#   * its in-plane offset = the material's cross-material RI anchor (applied
#     one-sided to the non-reference material only -- NOT centroid-cancelled)
#     plus that layer's own intra-material AA/AB shift.
# The real potential settings are included so masses / pair_style / pair_coeff
# match the registered spine; a single `run 0` validates the assembly before
# it is written to one data file.

clear
units           metal
atom_style      {{ atom_style }}
boundary        p p p

{{ box_region }}
create_box      {{ total_types }} box

# ---- read layers (bottom -> top) ---------------------------------------
{% for layer in layers %}
# material {{ layer.material_index }}, layer {{ layer.layer_index }}  (z = {{ "%.4f"|format(layer.z) }})
read_data       {{ layer.path }} add append shift 0.0 0.0 {{ "%.6f"|format(layer.z) }} group {{ layer.group }} offset {{ layer.type_offset }} 0 0 0 0 nocoeff
{% if layer.shift_x != 0.0 or layer.shift_y != 0.0 %}
displace_atoms  {{ layer.group }} move {{ "%.6f"|format(layer.shift_x) }} {{ "%.6f"|format(layer.shift_y) }} 0.0 units box
{% endif %}
{% endfor %}

# ---- masses (explicit, from the PotentialManager registry) --------------
{{ masses_block }}

# ---- real potential (pair_style / pair_coeff / masses) ------------------
include         {{ settings_path }}

run             0
write_data      {{ output_path }}
