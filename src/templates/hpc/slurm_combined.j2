#!/bin/bash
#SBATCH --nodes={{ nodes }}
#SBATCH --ntasks-per-node={{ ntasks_per_node }}
#SBATCH --cpus-per-task={{ cpus_per_task }}
#SBATCH --time={{ walltime }}
{% if array_size > 1 %}
#SBATCH --array=1-{{ array_size }}
#SBATCH --output={{ log_dir }}/{{ job_name }}_%a_out.txt
#SBATCH --error={{ log_dir }}/{{ job_name }}_%a_err.txt
{% else %}
#SBATCH --output={{ log_dir }}/{{ job_name }}_out.txt
#SBATCH --error={{ log_dir }}/{{ job_name }}_err.txt
{% endif %}
#SBATCH --job-name={{ job_name }}
{% if partition %}
#SBATCH --partition={{ partition }}
{% endif %}
{% if account %}
#SBATCH --account={{ account }}
{% endif %}
{% if mem %}
#SBATCH --mem={{ mem }}
{% endif %}

module purge
{% for mod in modules %}
module load {{ mod }}
{% endfor %}

{% if array_size > 1 %}
TASK_ID=${SLURM_ARRAY_TASK_ID}
{% else %}
TASK_ID=1
{% endif %}

SIM_PATH=$(sed -n "${TASK_ID}p" $SLURM_SUBMIT_DIR/hpc/{{ manifest_filename }})

if [ -z "$SIM_PATH" ]; then
    echo "Error: No simulation path for index ${TASK_ID}"
    exit 1
fi

# Strip any sim-root prefix that sits above afm/ or sheetonsheet/ (e.g. the
# K50_zeta0p1/ directory in a multi-sim array job). LAMMPS must be run from
# the directory that contains afm/ because that is what the relative paths
# inside the generated LAMMPS scripts are relative to.
LAMMPS_PREFIX=$(echo "$SIM_PATH" | sed 's|/afm/.*||; s|/sheetonsheet/.*||')
if [ "$LAMMPS_PREFIX" = "$SIM_PATH" ]; then
    # SIM_PATH starts with afm/ or sheetonsheet/ — no extra prefix.
    LAMMPS_PREFIX=""
    LAMMPS_SIM_PATH="$SIM_PATH"
else
    LAMMPS_SIM_PATH="${SIM_PATH#${LAMMPS_PREFIX}/}"
fi

{% if use_tmpdir %}
SIM_ROOT=$(basename "$SLURM_SUBMIT_DIR")
# Per-task scratch root keeps concurrent array tasks isolated from each other.
SCRATCH={{ scratch_dir }}/${SIM_ROOT}/task_${TASK_ID}

# Shared inputs (build/, provenance/potentials/) may live at an ancestor of
# SIM_PATH. Walk up to find the config-level root so every relative path the
# LAMMPS scripts reference resolves under SCRATCH.
COPY_ROOT="$SIM_PATH"
search="$SIM_PATH"
while [ "$search" != "." ] && [ "$search" != "/" ]; do
    if [ -d "$SLURM_SUBMIT_DIR/$search/provenance" ] || [ -d "$SLURM_SUBMIT_DIR/$search/build" ]; then
        COPY_ROOT="$search"
        break
    fi
    search=$(dirname "$search")
done

mkdir -p "$SCRATCH/$COPY_ROOT"
rsync -av --exclude='*.lammpstrj' --exclude='results/' --exclude='visuals/' "$SLURM_SUBMIT_DIR/$COPY_ROOT/" "$SCRATCH/$COPY_ROOT/"
mkdir -p "$SCRATCH/${SIM_PATH}/results" "$SCRATCH/${SIM_PATH}/visuals" "$SCRATCH/${SIM_PATH}/data"
if [ -n "$LAMMPS_PREFIX" ]; then
    cd "$SCRATCH/$LAMMPS_PREFIX"
else
    cd "$SCRATCH"
fi
{% else %}
if [ -n "$LAMMPS_PREFIX" ]; then
    cd "$SLURM_SUBMIT_DIR/$LAMMPS_PREFIX"
else
    cd "$SLURM_SUBMIT_DIR"
fi
{% endif %}

# Phase 1: system initialisation (writes load_*N.data)
{{ mpi_command }} lmp {{ lmp_flags }} -in ${LAMMPS_SIM_PATH}/lammps/system.in
if [ $? -ne 0 ]; then
    echo "Error: system.in failed for ${SIM_PATH}"
    exit 1
fi

# Phase 2: slide simulation (reads load_*N.data, loops over forces)
{{ mpi_command }} lmp {{ lmp_flags }} -in ${LAMMPS_SIM_PATH}/lammps/slide.in
if [ $? -ne 0 ]; then
    echo "Error: slide.in failed for ${SIM_PATH}"
    exit 1
fi

{% if use_tmpdir %}
mkdir -p "$SLURM_SUBMIT_DIR/${SIM_PATH}"
cp -r ${LAMMPS_SIM_PATH}/results ${LAMMPS_SIM_PATH}/visuals ${LAMMPS_SIM_PATH}/data "$SLURM_SUBMIT_DIR/${SIM_PATH}/"
cp ${LAMMPS_SIM_PATH}/load_*.data "$SLURM_SUBMIT_DIR/${SIM_PATH}/" 2>/dev/null || true
{% endif %}

echo "Simulation completed successfully: ${SIM_PATH}"
